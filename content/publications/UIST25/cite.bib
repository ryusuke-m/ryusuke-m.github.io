@inproceedings{10.1145/3746058.3759000,
 abstract = {We present a novel display method that can be perceived only when users gaze at the other object moving in a specific direction. This method employs high-speed projection of a striped pattern, allowing users to perceive different images corresponding to their gaze direction. In this paper, we describe the proposed method and demonstrate the technique through two gaze-dependent applications: a finger-tracing display that reveals content only when users slide their gaze across the surface while tracing a finger, and a pedestrian signage that becomes visible solely to people who keep their gaze on a smartphone while walking.},
 address = {New York, NY, USA},
 articleno = {18},
 author = {Miyazaki, Ryusuke and Miyafuji, Shio and Kim, Kyeongwan and Koike, Hideki},
 booktitle = {Adjunct Proceedings of the 38th Annual ACM Symposium on User Interface Software and Technology},
 doi = {10.1145/3746058.3759000},
 isbn = {9798400720369},
 keywords = {High-speed projection, Interaction devices, Human perception, Gaze},
 location = {},
 numpages = {3},
 publisher = {Association for Computing Machinery},
 series = {UIST Adjunct '25},
 title = {A Display Method Visible Only During Gaze Fixation on Moving Objects using High-Speed Projection and Striped Pattern},
 url = {https://doi.org/10.1145/3746058.3759000},
 year = {2025}
}

